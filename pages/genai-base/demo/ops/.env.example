# 教学用 .env サンプル。**実値はコミットしないこと**。
OPSM_ENV=onprem
OPSM_DATABASE_URL=postgresql+psycopg://opsm:change-me@postgres:5432/opsm
# MCP onprem-postgres から参照する読み取り専用 DSN（教学用：別ユーザを切る前提）
OPSM_DB_READONLY_URL=postgresql+psycopg://opsm_ro:change-me-ro@postgres:5432/opsm
OPSM_LOG_LEVEL=INFO

POSTGRES_USER=opsm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opsm
